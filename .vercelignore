# Only application source/configuration should be included in a deployment.
# Deployment exclusions are separate from Git exclusions; never upload case
# files, raw imports, backups, exports or credential containers.
.env*
.git
.next
node_modules
.vercel
/.github
/docs
/tests
/supabase
/scripts
/infra
/coverage
/artifacts
/output
/test-results
/playwright-report
src/**/*.test.ts
src/**/*.test.tsx
src/**/*.test-fixtures.ts
*.log
*.tsbuildinfo
--full-page
AGENTS.md
CLAUDE.md
*.html
*.htm
*.pdf

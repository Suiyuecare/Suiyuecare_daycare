# Local preview is opt-in and is forcibly disabled in production.
DEMO_MODE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Enable only after the Google provider, redirect allowlist and individual staff approvals are verified.
# OAuth client secrets belong in Supabase Auth, never in browser environment variables.
GOOGLE_LOGIN_ENABLED=false

# HMAC secret for five-minute, user/job/mode-bound PDF access URLs.
# Production value must be independently generated and at least 32 characters.
DOCUMENT_DOWNLOAD_SIGNING_SECRET=

# Raw central-system HTML archive (Tokyo, Object Lock enabled).
AWS_REGION=ap-northeast-1
HTML_ARCHIVE_BUCKET=
AWS_KMS_KEY_ID=

# Private attachment scanner. Run the infrastructure preflight before approval.
# mTLS authenticates this app; private_network needs verified network controls.
CLIENT_DOCUMENTS_SCANNER_APPROVED=false
CLIENT_DOCUMENTS_SCANNER_ACCESS_MODE=
CLIENT_DOCUMENTS_CLAMAV_HOST=
CLIENT_DOCUMENTS_CLAMAV_PORT=3310
CLIENT_DOCUMENTS_CLAMAV_CLIENT_CERT_PEM=
CLIENT_DOCUMENTS_CLAMAV_CLIENT_KEY_PEM=
CLIENT_DOCUMENTS_CLAMAV_CA_PEM=

# LINE and SMS stay disabled until procurement and consent gates pass.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SMS_PROVIDER=mock

# Server-only, read-only single-store Finance bridge. Leave blank until both
# organizations approve the binding. No default store ID or production secret.
# URL: https://<finance-project-ref>.supabase.co/functions/v1/daycare-store-finance-summary
# TOKEN: independently generated 32-byte secret encoded as 64 lowercase hex characters,
# matching Finance FINANCE_DAYCARE_SUMMARY_TOKEN. Never reuse a Supabase key.
FINANCE_STORE_SUMMARY_URL=
FINANCE_STORE_SUMMARY_TOKEN=
FINANCE_STORE_ORGANIZATION_ID=
FINANCE_STORE_BRANCH_ID=
FINANCE_STORE_ENTITY_ID=

NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Local preview is opt-in and is forcibly disabled in production.
DEMO_MODE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Enable only after the Google provider, redirect allowlist and CEO binding are verified.
# OAuth client secrets belong in Supabase Auth, never in browser environment variables.
GOOGLE_LOGIN_ENABLED=false

# HMAC secret for five-minute, user/job/mode-bound PDF access URLs.
# Production value must be independently generated and at least 32 characters.
DOCUMENT_DOWNLOAD_SIGNING_SECRET=

# Raw central-system HTML archive (Tokyo, Object Lock enabled).
AWS_REGION=ap-northeast-1
HTML_ARCHIVE_BUCKET=
AWS_KMS_KEY_ID=

# LINE and SMS stay disabled until procurement and consent gates pass.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SMS_PROVIDER=mock

NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

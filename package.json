{
  "name": "daycare-management-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "node scripts/test-database.mjs",
    "test:database:compile": "node scripts/test-database.mjs --compile-only",
    "test:database:native": "node scripts/test-native-database.mjs",
    "test:database:native:intake": "node scripts/test-intake-native.mjs",
    "test:database:native:questionnaire": "node scripts/test-questionnaire-native.mjs",
    "test:database:native:rules": "node scripts/test-questionnaire-rule-governance-native.mjs",
    "test:database:native:readiness": "node scripts/test-questionnaire-readiness-native.mjs",
    "test:database:native:questionnaire-receipts": "node scripts/test-questionnaire-operation-receipt-native.mjs",
    "test:database:native:claims": "node scripts/test-claim-operation-receipts-native.mjs",
    "test:database:native:nursing-receipts": "node scripts/test-nursing-operation-receipt-native.mjs",
    "test:database:native:staff-documents": "node scripts/test-staff-certificate-documents-native.mjs",
    "test:routes": "node scripts/test-page-routes.mjs",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:database && pnpm build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@aws-sdk/client-s3": "3.980.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
